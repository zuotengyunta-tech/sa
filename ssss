async function showStorageInfo() {
    let message = "📊 ストレージ情報\n\n";

    try {
        await openDB();
        const transaction = db.transaction(["sounds"], "readonly");
        const req = transaction.objectStore("sounds").getAll();

        req.onsuccess = () => {
            let totalBytes = 0;
            req.result.forEach(item => {
                totalBytes += (item.data ? item.data.length : 0);
            });

            const mb = (totalBytes / (1024 * 1024)).toFixed(2);
            message += `IndexedDB使用量: ${mb} MB\n`;
            message += req.result.length > 0 ? `保存済みファイル数: ${req.result.length}` : "ファイルなし";
            alert(message);
        };

        req.onerror = () => alert("容量情報取得失敗");
    } catch (e) {
        alert("IndexedDB未初期化");
    }
}

