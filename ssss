  /* ============ keyboard navigation ============ */
  tbody.addEventListener('keydown', (e) => {
    const cell = e.target.closest('td.cell');
    if (!cell) return;
    const editing = cell.classList.contains('editing');

    if (editing) {
      if (e.key === 'Escape') { e.preventDefault(); endEdit(cell); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const { r, c } = currentRC(cell);
        endEdit(cell);
        focusCell(r + 1, c);
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const { r, c } = currentRC(cell);
        endEdit(cell);
        focusCell(r, c + (e.shiftKey ? -1 : 1));
      }
      return;
    }

    const { r, c, matrix } = currentRC(cell);
    switch (e.key) {
      case 'ArrowUp': e.preventDefault(); focusCell(r - 1, c); break;
      case 'ArrowDown': e.preventDefault(); focusCell(r + 1, c); break;
      case 'ArrowLeft': e.preventDefault(); focusCell(r, c - 1); break;
      case 'ArrowRight': e.preventDefault(); focusCell(r, c + 1); break;
      case 'Home':
        e.preventDefault();
        if (e.ctrlKey || e.metaKey) focusCell(0, 0); else focusCell(r, 0);
        break;
      case 'End':
        e.preventDefault();
        if (e.ctrlKey || e.metaKey) focusCell(matrix.length - 1, matrix[matrix.length - 1].length - 1);
        else focusCell(r, matrix[r].length - 1);
        break;
      case 'Enter':
      case 'F2':
        e.preventDefault();
        if (cell.dataset.type === 'checkbox') toggleCheckbox(cell);
        else beginEdit(cell);
        break;
      case ' ':
        if (cell.dataset.type === 'checkbox') { e.preventDefault(); toggleCheckbox(cell); }
        else if (cell.dataset.type === 'checkbox') { /* noop */ }
        break;
      case 'Delete':
      case 'Backspace':
        if (cell.dataset.type === 'checkbox') { e.preventDefault(); setCheckbox(cell, false); }
        break;
      case 'Tab':
        e.preventDefault(); focusCell(r, c + (e.shiftKey ? -1 : 1));
        break;
    }
  });

