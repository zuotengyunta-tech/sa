<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>ポモドーロ ＆ 習慣データベース</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }
    body {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        background: #14141c;
    }

    #tabBar {
        position: sticky; top: 0; z-index: 100;
        display: flex; gap: 4px;
        padding: 10px 16px;
        background: #14141c;
        border-bottom: 1px solid #2a2a35;
    }
    #tabBar button {
        background: transparent; border: 1px solid transparent;
        color: #9aa4b2; padding: 8px 18px; border-radius: 8px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        font-family: inherit;
    }
    #tabBar button.active { background: #2383e2; color: #fff; }
    #tabBar button:hover:not(.active) { background: rgba(255,255,255,0.08); color: #fff; }

    .tabpanel { display: none; }
    #tabPomodoro.active { display: flex; justify-content: center; align-items: flex-start; }
    #tabHabit.active { display: block; }


    :root{
        --bg1: #0b1020;
        --bg2: #081127;
        --p-panel: rgba(255,255,255,0.04);
        --glass: rgba(255,255,255,0.04);
        --accent: #6f9cff;
        --accent-2: #7ee7b8;
        --muted: #aeb6c2;
        --success: #28a745;
        --danger: #dc3545;
        --warning: #ff9800;
    }

    /* page background: starfield + nebula */
    
    #tabPomodoro {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        background: radial-gradient(ellipse at 10% 10%, rgba(120,90,200,0.08) 0%, transparent 20%),
                    radial-gradient(ellipse at 90% 80%, rgba(10,120,200,0.06) 0%, transparent 18%),
                    linear-gradient(180deg, var(--bg1) 0%, var(--bg2) 100%);
        color: #e6eef8;
        margin: 0;
        padding: 28px;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

    /* animated star layers using pseudo elements */
    #tabPomodoro::before, #tabPomodoro::after{
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image:
            radial-gradient(2px 2px at 10% 20%, rgba(255,255,255,0.98) 50%, transparent 51%),
            radial-gradient(1px 1px at 40% 60%, rgba(255,255,255,0.9) 50%, transparent 51%),
            radial-gradient(1.4px 1.4px at 80% 30%, rgba(255,255,255,0.95) 50%, transparent 51%),
            radial-gradient(1px 1px at 30% 75%, rgba(255,255,255,0.85) 50%, transparent 51%),
            radial-gradient(0.8px 0.8px at 60% 10%, rgba(255,255,255,0.8) 50%, transparent 51%);
        background-repeat: repeat;
        opacity: 0.9;
        mix-blend-mode: screen;
        transform: translateZ(0);
    }
    #tabPomodoro::before { animation: moveStars 120s linear infinite; filter: blur(0.6px); }
    #tabPomodoro::after { animation: moveStars 200s linear infinite reverse; opacity:0.55; filter: blur(1.2px); }

    @keyframes moveStars {
        from { transform: translateY(0) translateX(0); }
        to { transform: translateY(-1200px) translateX(-600px); }
    }

    .container {
        width: 100%;
        max-width: 980px;
        position: relative;
        z-index: 2;
    }

    header.app-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        color: #eaf4ff;
    }
    header.app-header h1 {
        margin: 0;
        font-size: 22px;
        letter-spacing: -0.6px;
        display:flex;
        align-items:center;
        gap:12px;
    }
    header.app-header .logo {
        width:48px; height:48px;
        display:inline-grid;
        place-items:center;
        border-radius:12px;
        background: linear-gradient(135deg,#ff5f6d,#ffc371);
        box-shadow: 0 6px 20px rgba(0,0,0,0.45), inset 0 -6px 12px rgba(255,255,255,0.08);
        font-size:22px;
    }
    header.app-header p {
        margin:0;
        color:var(--muted);
        font-size:13px;
    }

    /* main layout */
    .grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 20px;
        align-items:start;
    }

    /* left panel */
    .panel {
        background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 8px 30px rgba(5,8,20,0.5);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .settings .input-row {
        display:flex;
        gap:8px;
        align-items:center;
        flex-wrap:wrap;
        margin:10px 0;
    }
    .settings label { font-size:14px; color: #eaf4ff; white-space:nowrap; }
    input[type="number"], select[type="text"], select {
        padding:8px 10px;
        border-radius:8px;
        border:1px solid rgba(255,255,255,0.06);
        background: rgba(0,0,0,0.25);
        color: #eaf4ff;
        min-width:64px;
    }
    input[type="checkbox"] { transform:scale(1.05); }

    .button-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 10px;
        margin-top:10px;
    }
    .button-grid button, .controls button {
        padding:10px 12px;
        border-radius:10px;
        border:none;
        cursor:pointer;
        font-weight:600;
        color:white;
        background: linear-gradient(180deg,var(--accent), #2f6fe6);
        box-shadow: 0 6px 18px rgba(45,70,160,0.25);
        transition: transform .12s ease, box-shadow .12s;
    }
    .button-grid button:hover { transform: translateY(-4px); box-shadow:0 12px 30px rgba(20,40,120,0.28); }
    .quick-btn { background: linear-gradient(180deg,#2fb670,#198754); }
    .preset-btn { background: linear-gradient(180deg,#6f42c1,#5a2fa6); padding:10px 14px; border-radius:10px; color:white; font-weight:700; box-shadow:0 6px 18px rgba(60,30,120,0.22); position:relative; }
    .delete-btn { position:absolute; top:-8px; right:-8px; width:26px; height:26px; border-radius:50%; background:var(--danger); color:white; border:none; cursor:pointer; box-shadow:0 6px 12px rgba(0,0,0,0.3); }

    /* right/main panel */
    .main {
        padding: 20px;
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
        border: 1px solid rgba(255,255,255,0.03);
        box-shadow: 0 8px 30px rgba(5,8,20,0.45);
    }

    #indicator { font-size:18px; margin-bottom:6px; color:var(--muted); display:flex; align-items:center; gap:10px; font-weight:700; }
    #timer {
        font-size: clamp(44px, 9vw, 88px);
        font-weight:800;
        margin: 8px 0 6px;
        padding: 18px 28px;
        display:inline-block;
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
        color: #f8fbff;
        box-shadow: 0 12px 30px rgba(0,0,0,0.5), inset 0 -6px 24px rgba(255,255,255,0.02);
        min-width: 180px;
        text-align:center;
    }
    .work { background: linear-gradient(180deg, rgba(124,255,163,0.08), rgba(20,80,20,0.04)); color: #e8fff0; }
    .break { background: linear-gradient(180deg, rgba(160,200,255,0.06), rgba(10,40,80,0.03)); color: #e8f3ff; }
    .stop { background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005)); color: #cbd5e1; }

    #remain { font-size:15px; color:var(--muted); margin-bottom:6px; min-height:24px; }
    .warn { color: var(--danger); font-weight:800; }

    .controls { display:flex; gap:10px; flex-wrap:wrap; margin: 12px 0 10px; }
    .controls .control {
        background: linear-gradient(180deg,#6c757d,#5b6368);
        padding:12px 16px;
        border-radius:10px;
        border:none;
        color:white;
        font-weight:700;
        cursor:pointer;
        box-shadow:0 6px 18px rgba(0,0,0,0.32);
    }

    #status { margin-top:6px; font-size:15px; color:var(--muted); font-weight:700; }

    #log { max-height:200px; overflow-y:auto; padding:10px; background: rgba(0,0,0,0.25); border-radius:10px; list-style:none; margin:10px 0 0; color:var(--muted); font-size:14px; }
    #log li { padding:6px 0; border-bottom:1px dashed rgba(255,255,255,0.02); }

    .modal-overlay { display:none; position:fixed; inset:0; align-items:center; justify-content:center; z-index:999; }
    .modal-overlay.show { display:flex; background: rgba(2,6,23,0.6); }
    .modal-content { background: linear-gradient(180deg,#0b1220, #071021); padding:20px; border-radius:12px; width:360px; color:#eaf4ff; box-shadow:0 12px 40px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.03); }

    .file-status { margin-left:8px; font-size:13px; color:var(--muted); display:inline-block; }
    .file-status.saved { color: var(--success); }

    #tabPomodoro footer { margin-top:16px; color:var(--muted); font-size:13px; text-align:center; }

    @media (max-width:920px){
        .grid { grid-template-columns: 1fr; }
        .container { padding-bottom:40px; }
    }

/* 見切れ対策強化 */
.container {
    padding: 20px 16px; /* 左右余白を確保 */
    box-sizing: border-box;
}

.grid {
    gap: 16px; /* 少し狭めて余裕を出す */
}

.panel, .main {
    min-width: 0; /* flex/gridの子要素の縮小を許可 */
    overflow: hidden; /* 内部はみ出し防止 */
}

.controls {
    flex-wrap: wrap;
    gap: 8px;
}

.controls button {
    flex: 1 1 auto;
    min-width: 110px; /* ボタンが小さくなりすぎない */
    white-space: nowrap;
}

/* 右パネルの内部要素も折りたたみやすく */
#main-controls-area, .main > div {
    flex-wrap: wrap;
    gap: 8px;
}

/* 中間サイズ対策（920px以下でも左パネルが圧迫されないように） */
@media (max-width: 980px) {
    .grid {
        grid-template-columns: 1fr;
    }
    .panel.settings {
        max-width: 100%;
    }
}

/* 超狭い画面（スマホ縦持ち） */
@media (max-width: 480px) {
    body {
        padding: 12px 8px;
    }
    .button-grid {
        grid-template-columns: repeat(2, 1fr); /* 3列→2列に */
        gap: 8px;
    }
    #timer {
        font-size: clamp(38px, 11vw, 68px);
        padding: 12px 16px;
    }
    .controls button {
        min-width: 100px;
        padding: 10px 8px;
        font-size: 14px;
    }
}




  :root{
    --bg: #191919;
    --panel: #202020;
    --border: #2f2f2f;
    --border-soft: #2a2a2a;
    --text: #e6e6e6;
    --text-dim: #9b9b9b;
    --text-faint: #6f6f6f;
    --blue: #2383e2;
    --green: #529e72;
    --red: #e85252;
    --hover: #242424;
    --select: #2383e2;
  }
  * { box-sizing: border-box; }
  #tabHabit {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
    user-select: none;
    min-height: 100vh;
  }
  .wrap { max-width: 100%; padding: 24px 24px 60px; }

  .page-title {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin-bottom: 16px; flex-wrap: wrap;
  }
  .page-title h1 {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 18px; font-weight: 600; margin: 0; color: var(--text);
  }
  .page-title h1::before { content: "✎"; opacity: .8; }
  .page-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* ---------- goal cards ---------- */
  .goals {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
    margin-bottom: 20px;
  }
  .goal-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 14px;
  }
  .goal-card .goal-title {
    font-size: 12px; color: var(--text-faint); margin-bottom: 6px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .goal-card .goal-title[contenteditable="true"], .goal-card .goal-body[contenteditable="true"] {
    outline: 1px dashed var(--blue); border-radius: 4px;
  }
  .goal-card .goal-body {
    font-size: 14px; color: var(--text); min-height: 40px; line-height: 1.5; white-space: pre-wrap;
  }
  .goal-card .goal-body:empty::before {
    content: "クリックして目標を入力…"; color: var(--text-faint);
  }
  .goal-bar { height: 4px; border-radius: 2px; background: #333; margin-top: 10px; overflow: hidden; }
  .goal-bar > i { display: block; height: 100%; background: var(--blue); width: 0%; transition: width .2s; }

  .btn {
    background: var(--panel); border: 1px solid var(--border); color: var(--text-dim);
    padding: 6px 12px; border-radius: 5px; font-size: 12.5px; cursor: pointer;
  }
  .btn:hover { background: var(--hover); color: var(--text); }
  .btn.primary { background: var(--blue); color: white; border-color: var(--blue); font-weight: 500; }
  .btn.primary:hover { filter: brightness(1.08); }

  .hint {
    color: var(--text-faint); font-size: 12px; margin-bottom: 10px;
  }
  .hint kbd {
    background: #2a2a2a; border: 1px solid #3a3a3a; border-radius: 4px;
    padding: 1px 5px; font-size: 11px; color: #cfcfcf; font-family: inherit;
  }

  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
  .sync-status { font-size: 12px; color: var(--text-faint); }

  .table-scroll {
    overflow: auto; border-top: 1px solid var(--border); border-radius: 3px; max-height: 60vh;
  }
  table { border-collapse: collapse; font-size: 13px; min-width: 1500px; width: 100%; }
  thead th {
    position: sticky; top: 0; background: var(--bg); color: var(--text-dim); font-weight: 500;
    text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border-soft); white-space: nowrap; z-index: 2;
  }
  th .hcell { display: flex; align-items: center; gap: 6px; }

  tbody td {
    padding: 6px 8px; border-bottom: 1px solid var(--border-soft); border-right: 1px solid var(--border-soft);
    white-space: nowrap; vertical-align: middle; outline: none; cursor: default;
  }
  tbody tr:hover td { background: var(--hover); }

  td.cell:focus { box-shadow: inset 0 0 0 2px var(--select); background: rgba(35,131,226,0.08); }
  td.cell.editing { box-shadow: inset 0 0 0 2px var(--green); background: rgba(82,158,114,0.10); cursor: text; }

  td.title { width: 28px; text-align: center; color: var(--text-faint); }
  td.date { color: var(--text); min-width: 96px; }

  td.cbcell { text-align: left; width: 34px; cursor: pointer; }
  .cb {
    display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px;
    border-radius: 3px; border: 1px solid #4a4a4a; background: transparent; pointer-events: none;
  }
  .cb.on { background: var(--blue); border-color: var(--blue); }
  .cb.on svg { width: 10px; height: 10px; }
  td.cbcell[data-group="bonus"] .cb.on { background: #6b3fa0; border-color: #6b3fa0; }

  td.text { color: var(--text); min-width: 90px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
  td.text[contenteditable="true"] { overflow: visible; white-space: normal; user-select: text; }
  td.study-synced { color: #7ecb96; }

  td.pctcell { width: 76px; }
  .ringwrap { display: inline-flex; align-items: center; gap: 6px; }
  .ring { width: 18px; height: 18px; flex: none; }
  .ringfg { transition: stroke-dashoffset .25s ease; }
  .pct { color: var(--text); font-variant-numeric: tabular-nums; }
  .pctsign { color: var(--text); }
  td.pcttext { color: var(--text); text-align: right; font-variant-numeric: tabular-nums; }

  .footer-note { margin-top: 10px; color: var(--text-faint); font-size: 12px; display: flex; justify-content: space-between; align-items: center; }

  /* ---------- chart section ---------- */
  .chart-section {
    margin-top: 26px; border: 1px solid var(--border); border-radius: 8px;
    padding: 16px 18px 18px; background: var(--panel);
  }
  .chart-head {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-bottom: 12px;
  }
  .chart-title { font-size: 14px; font-weight: 600; color: var(--text); }
  .tabgroup { display: flex; gap: 4px; background: #262626; border-radius: 6px; padding: 3px; }
  .tabgroup button {
    background: transparent; border: none; color: var(--text-dim); font-size: 12.5px;
    padding: 5px 12px; border-radius: 5px; cursor: pointer;
  }
  .tabgroup button.active { background: var(--blue); color: white; }
  .tabgroup.metric button.active { background: var(--green); }
  .chart-controls { display: flex; gap: 10px; flex-wrap: wrap; }

  svg.trend { width: 100%; height: 260px; display: block; }
  .gridline { stroke: #333; stroke-width: 1; }
  .axislabel { fill: var(--text-faint); font-size: 10.5px; }
  .trendline { fill: none; stroke: var(--blue); stroke-width: 2; }
  .trendarea { fill: url(#areaGrad); opacity: .5; }
  .trenddot { fill: var(--blue); stroke: var(--bg); stroke-width: 1.5; cursor: pointer; }
  .trenddot:hover { r: 4.5; }
  .avgline { stroke: var(--text-faint); stroke-width: 1; stroke-dasharray: 4 3; }
  .avglabel { fill: var(--text-faint); font-size: 10px; }
  .legend { display: flex; gap: 14px; margin-top: 8px; font-size: 11.5px; color: var(--text-dim); }
  .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }

</style>
</head>
<body>
    <div id="tabBar">
        <button class="tabbtn active" data-tab="tabPomodoro">🍅 ポモドーロ</button>
        <button class="tabbtn" data-tab="tabHabit">📋 習慣データベース</button>
    </div>

    <div id="tabPomodoro" class="tabpanel active">
<div class="container">
        <header class="app-header">
            <div class="logo">🍅</div>
            <div>
                <h1>ポモドーロ 強化版（宇宙テーマ）</h1>
                <p>機能はそのまま、UIを磨いて省電力モードを改善しました</p>
            </div>
        </header>

        <div class="grid">
            <aside class="panel settings" aria-label="設定パネル">
                <div class="input-row">
                    <label><input type="checkbox" id="autoBreakEnabled" checked> <strong>自動休憩モード</strong></label>
                    <span style="color:var(--muted); font-size:13px;">（OFFでも長休憩後は自動開始）</span>
                </div>
                <div class="input-row">
                    <label><input type="checkbox" id="autoWorkEnabled" checked> <strong>自動勉強モード</strong></label>
                    <span style="color:var(--muted); font-size:13px;">（OFFにすると休憩終了後停止）</span>
                </div>

                <div class="input-row" style="margin-top:8px;">
                    <label>勉強</label><input id="work" value="25" type="number" min="1"> 分
                </div>
                <div class="input-row">
                    <label>短休憩</label><input id="break" value="5" type="number" min="1"> 分
                    <label>長休憩</label>
                    <select id="longBreak">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20" selected>20</option>
                        <option value="25">25</option>
                        <option value="30">30</option>
                    </select> 分
                </div>
                <div class="input-row">
                    <label>サイクル</label><input id="cycle" value="3" type="number" min="1"> 回
                    <label><input type="checkbox" id="cycleEnabled" checked onchange="handleCycleChange()"> 長休憩ON</label>
                </div>

                <div style="height:8px;"></div>
                <h4 style="margin:6px 0 6px;color:var(--muted);font-size:14px;">クイック設定 — 勉強時間</h4>
                <div class="button-grid">
                    <button class="quick-btn" onclick="quickSet('work',15)">15分</button>
                    <button class="quick-btn" onclick="quickSet('work',20)">20分</button>
                    <button class="quick-btn" onclick="quickSet('work',25)">25分</button>
                    <button class="quick-btn" onclick="quickSet('work',30)">30分</button>
                    <button class="quick-btn" onclick="quickSet('work',40)">40分</button>
                    <button class="quick-btn" onclick="quickSet('work',50)">50分</button>
                </div>

                <h4 style="margin-top:10px;color:var(--muted);font-size:14px;">短い休憩</h4>
                <div class="button-grid">
                    <button onclick="quickSet('break',3)">3分</button>
                    <button onclick="quickSet('break',5)">5分</button>
                    <button onclick="quickSet('break',7)">7分</button>
                    <button onclick="quickSet('break',10)">10分</button>
                    <button onclick="quickSet('break',15)">15分</button>
                </div>

                <h4 style="margin-top:10px;color:var(--muted);font-size:14px;">プリセット</h4>
                <div id="presets" style="margin-bottom:8px;"></div>
                <div style="display:flex; gap:10px; margin-top:8px;">
                    <button onclick="showNameInput()">💾 保存</button>
                    <button onclick="startBreakOnly()" style="background:linear-gradient(180deg,#17a2b8,#0f7b89)">☕ 休憩だけ開始</button>
                </div>

