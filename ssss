<script>

// ==================== グローバル設定 ====================
const PRESET_KEY = "pomodoro_presets";
const LOG_KEY = "pomodoro_today_study";

let timerInterval = null;
let timeLeft = 1500;
let isRunning = false;
let isWork = true;
let cycleCount = 0;
let cycleModeEnabled = true;
let breakOnlyMode = false;
let autoBreakEnabled = true;
let autoWorkEnabled = true;
let floatWin = null;
let currentAudio = null;
let audioContext = null;
let lastTitleUpdate = 0;
let endTimestamp = null;
let db = null;
let dbVersion = 5;

// tick base: normal small tick for smoothness, but powerSave will lengthen
let tickBaseMs = 250;
