  /* ============ 行生成 ============ */
  function ringSvg(){
    return `<span class="ringwrap"><svg viewBox="0 0 18 18" class="ring">
      <circle cx="9" cy="9" r="7" fill="none" stroke="#3a3a3a" stroke-width="2.5"/>
      <circle cx="9" cy="9" r="7" fill="none" stroke="#529cca" stroke-width="2.5" stroke-dasharray="43.98" stroke-dashoffset="43.98" transform="rotate(-90 9 9)" class="ringfg"/>
      </svg><span class="pct">0</span><span class="pctsign">%</span></span>`;
  }

  function buildRow(date, onKeys, studyText, minutes, studyLabel){
    const tr = document.createElement('tr');
    tr.dataset.date = date;
    let html = `<td class="cell title" tabindex="0" data-col="0" data-type="fixed"><span>⋮</span></td>`;
    html += `<td class="cell date" tabindex="0" data-col="1" data-type="text" contenteditable="false">${date}</td>`;
    ITEMS.forEach((it, i) => {
      const on = onKeys.includes(it.k) ? 'on' : '';
      const check = on ? '<svg viewBox="0 0 16 16"><path d="M6.5 11.5L3 8l1-1 2.5 2.5L12 4l1 1z" fill="white"/></svg>' : '';
      html += `<td class="cell cbcell" tabindex="0" data-col="${i+2}" data-type="checkbox" data-item="${it.k}" data-group="${it.g}"><span class="cb ${on}">${check}</span></td>`;
    });
    html += `<td class="cell text" tabindex="0" data-col="14" data-type="text" contenteditable="false">${studyText||''}</td>`;
    html += `<td class="cell text" tabindex="0" data-col="15" data-type="text" data-minutes="${minutes||0}" contenteditable="false">${studyLabel||''}</td>`;
    html += `<td class="cell pctcell" tabindex="0" data-col="16" data-type="pct-core">${ringSvg()}</td>`;
    html += `<td class="cell pcttext" tabindex="0" data-col="17" data-type="pct-bonus">0<span class="pctsign">%</span></td>`;
    tr.innerHTML = html;
    return tr;
  }

