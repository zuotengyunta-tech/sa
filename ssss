  /* ============ grid helpers ============ */
  function getMatrix(){
    return Array.from(tbody.querySelectorAll('tr')).map(tr => Array.from(tr.querySelectorAll('td.cell')));
  }
  function focusCell(r, c){
    const matrix = getMatrix();
    if (matrix.length === 0) return;
    r = Math.max(0, Math.min(matrix.length - 1, r));
    const rowCells = matrix[r];
    c = Math.max(0, Math.min(rowCells.length - 1, c));
    const cell = rowCells[c];
    if (cell) { cell.focus(); cell.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
  }
  function currentRC(el){
    const tr = el.closest('tr');
    const matrix = getMatrix();
    const r = Array.from(tbody.children).indexOf(tr);
    const c = Array.from(tr.querySelectorAll('td.cell')).indexOf(el);
    return { r, c, matrix };
  }

  /* ============ checkbox + linked % ============ */
  function setCheckbox(cell, on){
    const cb = cell.querySelector('.cb');
    if (!cb) return;
    if (on) {
      cb.classList.add('on');
      cb.innerHTML = '<svg viewBox="0 0 16 16"><path d="M6.5 11.5L3 8l1-1 2.5 2.5L12 4l1 1z" fill="white"/></svg>';
    } else {
      cb.classList.remove('on');
      cb.innerHTML = '';
    }
    recomputeRow(cell.closest('tr'));
  }
  function toggleCheckbox(cell){
    const cb = cell.querySelector('.cb');
    if (!cb) return;
    setCheckbox(cell, !cb.classList.contains('on'));
  }

  function recomputeRow(tr){
    if (!tr) return;
    let coreYes = 0, bonusYes = 0;
    tr.querySelectorAll('td.cbcell').forEach(td => {
      const on = td.querySelector('.cb').classList.contains('on');
      if (!on) return;
      if (td.dataset.group === 'core') coreYes++;
      else bonusYes++;
    });
    const achievePct = Math.round(coreYes / CORE.length * 100);
    const bonusPct = Math.round(bonusYes / BONUS.length * 100);

    const achieveCell = tr.querySelector('td[data-type="pct-core"]');
    const bonusCell = tr.querySelector('td[data-type="pct-bonus"]');
    achieveCell.querySelector('.pct').textContent = achievePct;
    updateRing(achieveCell, achievePct);
    bonusCell.childNodes[0].textContent = bonusPct;
  }

  function updateRing(cell, v){
    const svg = cell.querySelector('.ring');
    const r = 7, c = 2 * Math.PI * r;
    const off = c * (1 - v / 100);
    const fg = svg.querySelector('.ringfg');
    fg.setAttribute('stroke-dasharray', c.toFixed(2));
    fg.setAttribute('stroke-dashoffset', off.toFixed(2));
  }

  /* ============ text edit ============ */
  function beginEdit(cell){
    if (cell.dataset.type === 'checkbox' || cell.dataset.type === 'fixed' ||
        cell.dataset.type === 'pct-core' || cell.dataset.type === 'pct-bonus') return;
    cell.classList.add('editing');
    cell.setAttribute('contenteditable', 'true');
    cell.focus();
    selectAllText(cell);
  }
  function selectAllText(el){
    const range = document.createRange();
    range.selectNodeContents(el);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
  function endEdit(cell){
    cell.classList.remove('editing');
    cell.setAttribute('contenteditable', 'false');
    cell.classList.remove('study-synced');
    cell.focus();
  }

