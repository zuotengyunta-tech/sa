// ==================== 予約開始（指定時刻に自動でタイマーを開始） ====================
const SCHEDULE_KEY = "pomodoro_schedule";

function loadScheduleSettings() {
    try {
        const saved = JSON.parse(localStorage.getItem(SCHEDULE_KEY) || "{}");
        els.scheduleEnabled.checked = !!saved.enabled;
        if (saved.time) els.scheduleTime.value = saved.time;
