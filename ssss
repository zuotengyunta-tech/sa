    cycleEnabled: document.getElementById("cycleEnabled"),
    autoBreakEnabled: document.getElementById("autoBreakEnabled"),
    autoWorkEnabled: document.getElementById("autoWorkEnabled"),
    soundMode: document.getElementById("soundMode"),
    soundDuration: document.getElementById("soundDuration"),
    soundFile: document.getElementById("soundFile"),
    presets: document.getElementById("presets"),
    nameModal: document.getElementById("nameInputModal"),
    presetNameInput: document.getElementById("presetName"),
    soundEvent: document.getElementById("soundEvent"),
    fileStatus: document.getElementById("fileStatus"),
    resetCycleCheckbox: document.getElementById("resetCycleCheckbox"),
    addStudyCheckbox: document.getElementById("addStudyCheckbox"),
    cycleDisplay: document.getElementById("cycleDisplay"),
    powerSaveCheckbox: document.getElementById("powerSave"),
    scheduleEnabled: document.getElementById("scheduleEnabled"),
    scheduleTime: document.getElementById("scheduleTime"),
    scheduleStatus: document.getElementById("scheduleStatus")
};

// ==================== IndexedDB管理 ====================
function openDB() {
    return new Promise((resolve, reject) => {
        if (db) { resolve(db); return; }
        const request = indexedDB.open("PomodoroSounds", dbVersion);

        request.onupgradeneeded = (e) => {
            const dbUpgrade = e.target.result;
            if (!dbUpgrade.objectStoreNames.contains("sounds")) {
                dbUpgrade.createObjectStore("sounds", { keyPath: "type" });
            }
        };

        request.onsuccess = (e) => { db = e.target.result; resolve(db); };
        request.onerror = () => { console.error("IndexedDBエラー:", request.error); reject(request.error); };
        request.onblocked = () => { console.warn("IndexedDBがブロックされています"); reject(new Error("blocked")); };
    });
}

async function restartIndexedDB() {
    if (!confirm("IndexedDBを完全に再起動します。\nすべての音声データが削除されます。")) return;

    try {
        if (db) { db.close(); db = null; }

        await new Promise((resolve, reject) => {
            const deleteReq = indexedDB.deleteDatabase("PomodoroSounds");
            deleteReq.onsuccess = () => resolve();
            deleteReq.onerror = () => reject(deleteReq.error);
        });

        await new Promise(r => setTimeout(r, 300));
        await openDB();

        Object.keys(soundSettings).forEach(key => {
            soundSettings[key].mode = "beep";
            soundSettings[key].url = "";
        });
        saveSoundSettings();

        alert("✅ IndexedDBを再起動しました");
        await loadSoundSettings();
        loadSoundSetting();
    } catch (e) {
        console.error(e);
        alert("再起動に失敗しました。ページをリロードしてください。");
    }
}

// ==================== 音声再生 ====================
function getAudioContext() {
    if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
    return audioContext;
}

async function maybeResumeAudioContext() {
    try {
        const ctx = getAudioContext();
        if (ctx.state === "suspended") await ctx.resume();
    } catch (e) { /* ignore */ }
}

async function maybeSuspendAudioContext() {
    try {
        if (!audioContext) return;
        if (audioContext.state === "running") await audioContext.suspend();
    } catch (e) { /* ignore */ }
}

function playBeep(freq, duration = 200, volume = 0.6, type = 'sine') {
    try {
        const ctx = getAudioContext();
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();
        oscillator.type = type;
        oscillator.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.value = volume;
        oscillator.connect(gain);
        gain.connect(ctx.destination);
        oscillator.start();
        setTimeout(() => {
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.05);
            oscillator.stop(ctx.currentTime + 0.1);
        }, duration);
    } catch (e) {
        console.warn("ビープ音再生エラー:", e);
    }
}

async function playNotification(type) {
    const setting = soundSettings[type] || soundSettings.workEnd;
    if (setting.mode === "off") return;
    stopSound();

    try {
        if (setting.mode === "custom") {
            const audioUrl = await loadSoundFile(type);
            if (audioUrl) {
                currentAudio = new Audio(audioUrl);
                currentAudio.volume = 0.85;
                await currentAudio.play().catch(e => console.warn(e));
                setTimeout(stopSound, (setting.duration || 4) * 1000);
            } else {
                playDefaultBeep();
            }
        } else {
            await maybeResumeAudioContext();
            playDefaultBeep();
        }
    } catch (e) {
        console.warn("音声再生エラー:", e);
        playDefaultBeep();
    }
}

function playDefaultBeep() {
    playBeep(720, 120, 0.6, 'sine');
    setTimeout(() => playBeep(980, 160, 0.6, 'sine'), 120);
}

function stopSound() {
    if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
        currentAudio = null;
    }
}

// ==================== 音声ファイル管理 ====================
async function saveSoundFile(eventType, file) {
    try {
        await openDB();
        const dataUrl = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error("FileReader failed"));
            reader.readAsDataURL(file);
        });

        return new Promise((resolve, reject) => {
            const transaction = db.transaction(["sounds"], "readwrite");
            const store = transaction.objectStore("sounds");
            const data = {
                type: eventType,
                data: dataUrl,
                filename: file.name,
                size: file.size || 0,
                timestamp: Date.now()
            };

            const putReq = store.put(data);
            putReq.onerror = () => reject(putReq.error);
            transaction.oncomplete = () => resolve();
            transaction.onerror = () => reject(transaction.error);
        });
    } catch (e) {
        console.error("ファイル保存エラー:", e);
        throw e;
    }
}

async function loadSoundFile(eventType) {
    try {
        await openDB();
        return new Promise((resolve) => {
            const transaction = db.transaction(["sounds"], "readonly");
            const req = transaction.objectStore("sounds").get(eventType);
            req.onsuccess = () => resolve(req.result ? req.result.data : null);
            req.onerror = () => resolve(null);
        });
    } catch (e) {
        console.warn("ファイル読み込みエラー:", e);
        return null;
    }
}

async function deleteSound(eventType) {
    try {
        await openDB();
        return new Promise((resolve, reject) => {
            const transaction = db.transaction(["sounds"], "readwrite");
            const req = transaction.objectStore("sounds").delete(eventType);
            req.onerror = () => reject(req.error);
            transaction.oncomplete = () => resolve();
        });
    } catch (e) {
        console.warn("削除エラー:", e);
    }
}

// ==================== 音声設定UI ====================
function loadSoundSetting() {
    const type = els.soundEvent.value;
    const s = soundSettings[type] || soundSettings.workEnd;

    els.soundMode.value = s.mode || "beep";
    els.soundDuration.value = s.duration || 5;

    updateFileStatus(type);
}

async function updateFileStatus(type) {
    try {
        await openDB();
        const transaction = db.transaction(["sounds"], "readonly");
        const req = transaction.objectStore("sounds").get(type);

        req.onsuccess = () => {
            if (req.result && req.result.filename) {
                els.fileStatus.textContent = `✅ 保存済み (${req.result.filename})`;
                els.fileStatus.classList.add("saved");
                soundSettings[type].mode = "custom";
            } else {
                els.fileStatus.textContent = "未選択";
                els.fileStatus.classList.remove("saved");
            }
        };
        req.onerror = () => {
            els.fileStatus.textContent = "未選択";
            els.fileStatus.classList.remove("saved");
        };
    } catch (e) {
        els.fileStatus.textContent = "未選択";
        els.fileStatus.classList.remove("saved");
    }
}

function saveSoundSetting() {
    const type = els.soundEvent.value;
    soundSettings[type].mode = els.soundMode.value;
    soundSettings[type].duration = parseInt(els.soundDuration.value) || 5;
    saveSoundSettings();
}

function saveSoundSettings() {
    try {
        localStorage.setItem("pomodoro_soundSettings", JSON.stringify(soundSettings));
    } catch (e) {
        console.warn("設定保存エラー:", e);
    }
}

async function loadSoundSettings() {
    try {
        const saved = localStorage.getItem("pomodoro_soundSettings");
        if (saved) {
            const parsed = JSON.parse(saved);
            Object.keys(parsed).forEach(key => {
                if (soundSettings[key]) {
                    soundSettings[key].mode = parsed[key].mode || "beep";
                    soundSettings[key].duration = parsed[key].duration || 5;
                }
            });
        }
    } catch (e) {
        console.warn("設定読み込みエラー:", e);
    }
}

// ==================== ファイル入力イベント ====================
els.soundFile.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    if (!file.type.startsWith('audio/')) {
        alert("❌ 音声ファイルのみ選択してください");
        return;
    }

    const eventType = els.soundEvent.value;

    try {
        await saveSoundFile(eventType, file);
        soundSettings[eventType].mode = "custom";
        soundSettings[eventType].duration = parseInt(els.soundDuration.value) || 4;
        saveSoundSettings();
        alert(`✅ 保存完了: ${file.name}`);
        updateFileStatus(eventType);
        e.target.value = '';
    } catch (e) {
        console.error(e);
        alert("❌ 保存に失敗しました");
    }
});

// ==================== タイマー機能 ====================
function computeTickMs() {
    // 通常は細かめのtickでUI滑らかに。省電力時は1秒ごとに制限。
    return powerSave ? 1000 : tickBaseMs;
}

function startTimerInterval() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(tick, computeTickMs());
}

function tick() {
    if (!isRunning || !timerInterval) return;
    // 現在は endTimestamp を正確に参照して秒単位で算出
    const now = Date.now();
    timeLeft = Math.max(0, Math.ceil((endTimestamp - now) / 1000));
    updateTimerDisplay();
    if (floatWin && !floatWin.closed) updateFloatWindow();
    if (timeLeft <= 0) handleTimerComplete();
}

function handleTimerComplete() {
    clearInterval(timerInterval);
    timerInterval = null;
    isRunning = false;
    endTimestamp = null;

    const wasWork = isWork;

    if (wasWork) {
        updateTodayStudyTime(getWork());
        cycleCount++;
        updateCycleDisplay();

        const shouldLongBreak = cycleModeEnabled && els.cycleEnabled.checked &&
                               cycleCount % parseInt(els.cycle.value || 4) === 0;

        const breakDuration = shouldLongBreak ? getLong() : getBreak();
        const breakType = shouldLongBreak ? "long" : "short";
        const breakName = shouldLongBreak ? "長休憩" : "短休憩";

        isWork = false;
        timeLeft = breakDuration;

        notify(breakName + "開始", breakType + "Start");

        if (autoBreakEnabled) {
            isRunning = true;
            endTimestamp = Date.now() + (timeLeft * 1000);
            startTimerInterval();
            els.status.textContent = breakName + "中";
        } else {
            els.status.textContent = breakName + " - 開始を押してください";
        }
    } else {
        // 休憩終了
        notify("勉強開始", "workStart");
        isWork = true;
        timeLeft = getWork();

        if (autoWorkEnabled) {
            isRunning = true;
            endTimestamp = Date.now() + (timeLeft * 1000);
            startTimerInterval();
            els.status.textContent = "勉強中";
        } else {
            els.status.textContent = "勉強 - 開始を押してください";
        }
    }
    updateUI();
}

function notify(text, type = "workEnd") {
    els.status.textContent = text;
    playNotification(type);
    if (Notification.permission === "granted") {
        try { new Notification("ポモドーロ", { body: text, tag: type, renotify: true }); } catch(e) {}
    }
}

function updateTimerDisplay() {
    const m = Math.floor(timeLeft / 60);
    const s = timeLeft % 60;
    const timeStr = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
    els.timer.textContent = timeStr;
    const remainMin = Math.ceil(timeLeft / 60);
    els.remain.textContent = `残り ${remainMin} 分`;
    els.remain.className = remainMin <= 5 ? "warn" : "";

    if (Date.now() - lastTitleUpdate > (powerSave ? 2500 : 800)) {
        document.title = isRunning ? `【${isWork ? '勉強' : '休憩'}】${timeStr}` : "ポモドーロ";
        lastTitleUpdate = Date.now();
    }
}

function updateUI() {
    if (!isRunning) {
        els.timer.className = "stop";
        els.indicator.textContent = "● 停止中";
    } else if (isWork) {
        els.timer.className = "work";
        els.indicator.textContent = "● 勉強中";
    } else {
        els.timer.className = "break";
        els.indicator.textContent = "● 休憩中";
    }
    updateTimerDisplay();
    if (floatWin && !floatWin.closed) updateFloatWindow();
}

// ==================== コントローラ ====================
function start() {
    if (isRunning) return;
    breakOnlyMode = false;
    if (timeLeft <= 0) {
        timeLeft = isWork ? getWork() : getBreak();
    }
    isRunning = true;
    endTimestamp = Date.now() + (timeLeft * 1000);
    if (timerInterval) clearInterval(timerInterval);
    startTimerInterval();
    updateUI();
}

function pause() {
    if (!isRunning) return;
    isRunning = false;
    if (endTimestamp) {
        timeLeft = Math.max(0, Math.ceil((endTimestamp - Date.now()) / 1000));
    }
    if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
    if (isWork) {
        const elapsed = getWork() - timeLeft;
        if (elapsed > 0 && !skipStudyOnPause) updateTodayStudyTime(elapsed);
    }
    updateUI();
}

function reset() {
    // リセット時のオプションを確認
    const resetCycle = els.resetCycleCheckbox.checked;
    const addStudy = els.addStudyCheckbox.checked;

    // 一時的に pause() の挙動を変える
    skipStudyOnPause = !addStudy;
    pause();
    skipStudyOnPause = false;

    breakOnlyMode = false;
    isWork = true;
    if (resetCycle) {
        cycleCount = 0;
    }
    timeLeft = getWork();
    endTimestamp = null;
    els.status.textContent = "待機中";
    updateCycleDisplay();
    updateUI();
}

function startBreakOnly() {
    pause();
    breakOnlyMode = true;
    isWork = false;
    cycleCount = 0;
    timeLeft = getBreak();
    updateUI();
    isRunning = true;
    endTimestamp = Date.now() + (timeLeft * 1000);
    startTimerInterval();
    els.status.textContent = "休憩モード開始";
}

// ==================== ヘルパー関数 ====================
function getWork() { return Math.max(1, parseInt(els.work.value) || 25) * 60; }
function getBreak() { return Math.max(1, parseInt(els.break.value) || 5) * 60; }
function getLong() { return Math.max(1, parseInt(els.longBreak.value) || 20) * 60; }

function quickSet(type, min) {
    if (type === 'work') els.work.value = Math.max(1, min);
    if (type === 'break') els.break.value = Math.max(1, min);
    if (type === 'long') els.longBreak.value = Math.max(1, min);
    reset();
}

function handleCycleChange() { reset(); }

// サイクル加減算（現在の cycleCount を増減）
function adjustCycle(delta) {
    cycleCount = Math.max(0, cycleCount + delta);
    updateCycleDisplay();
}

// サイクル表示更新
