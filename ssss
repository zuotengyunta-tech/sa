  function parseDate(s){
    const [y,m,d] = s.split('/').map(Number);
    return new Date(y, m-1, d);
  }

  function collectSeries(){
    const rows = Array.from(tbody.querySelectorAll('tr')).map(tr => {
      const cells = tr.querySelectorAll('td.cell');
      const dateStr = cells[1].textContent.trim();
      const minutes = parseInt(cells[15].dataset.minutes || '0', 10);
      const achieve = parseInt(cells[16].querySelector('.pct').textContent, 10) || 0;
      const bonus = parseInt(cells[17].childNodes[0].textContent, 10) || 0;
      return { date: dateStr, dateObj: parseDate(dateStr), minutes, achieve, bonus };
    });
    rows.sort((a,b) => a.dateObj - b.dateObj);
    return rows;
  }

  function renderChart(){
    const all = collectSeries();
    if (all.length === 0) return;
    const latest = all[all.length - 1].dateObj;
    const cutoff = new Date(latest);
    cutoff.setDate(cutoff.getDate() - (currentRange - 1));
    const series = all.filter(r => r.dateObj >= cutoff);

    const key = currentMetric === 'minutes' ? 'minutes' : (currentMetric === 'achieve' ? 'achieve' : 'bonus');
    const values = series.map(r => r[key]);
    const maxRaw = Math.max(1, ...values);
    let yMax;
    if (key === 'minutes') {
      yMax = Math.ceil(maxRaw / 30) * 30 || 30;
    } else {
      yMax = 100;
    }

    const svgW = 900, svgH = 260;
    const padL = 40, padR = 16, padT = 16, padB = 28;
    const plotW = svgW - padL - padR;
    const plotH = svgH - padT - padB;

    const n = series.length;
    const xStep = n > 1 ? plotW / (n - 1) : 0;
    const xAt = (i) => padL + xStep * i;
    const yAt = (v) => padT + plotH - (v / yMax) * plotH;

    const avg = values.reduce((a,b) => a+b, 0) / (values.length || 1);

    let gridSvg = '';
    const gridCount = 4;
    for (let i = 0; i <= gridCount; i++) {
      const gy = padT + (plotH / gridCount) * i;
      const val = Math.round(yMax - (yMax / gridCount) * i);
      gridSvg += `<line class="gridline" x1="${padL}" y1="${gy.toFixed(1)}" x2="${svgW-padR}" y2="${gy.toFixed(1)}"/>`;
      gridSvg += `<text class="axislabel" x="${padL-6}" y="${(gy+3).toFixed(1)}" text-anchor="end">${val}${key==='minutes'?'':'%'}</text>`;
    }

    let labelSvg = '';
    const labelEvery = Math.max(1, Math.ceil(n / 8));
    for (let i = 0; i < n; i += labelEvery) {
      const d = series[i].date.slice(5);
      labelSvg += `<text class="axislabel" x="${xAt(i).toFixed(1)}" y="${svgH-8}" text-anchor="middle">${d}</text>`;
    }
    if ((n - 1) % labelEvery !== 0) {
      const i = n - 1;
      labelSvg += `<text class="axislabel" x="${xAt(i).toFixed(1)}" y="${svgH-8}" text-anchor="middle">${series[i].date.slice(5)}</text>`;
    }

    let pathD = '';
    let areaD = '';
    let dotsSvg = '';
    series.forEach((r, i) => {
      const x = xAt(i), y = yAt(r[key]);
      pathD += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1) + ' ';
      const label = key === 'minutes' ? (r.minutes + '分') : (r[key] + '%');
      dotsSvg += `<circle class="trenddot" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3"><title>${r.date} : ${label}</title></circle>`;
    });
    if (n > 0) {
      areaD = pathD + `L${xAt(n-1).toFixed(1)},${(padT+plotH).toFixed(1)} L${xAt(0).toFixed(1)},${(padT+plotH).toFixed(1)} Z`;
    }

    const avgY = yAt(avg);
    const avgSvg = `<line class="avgline" x1="${padL}" y1="${avgY.toFixed(1)}" x2="${svgW-padR}" y2="${avgY.toFixed(1)}"/>
      <text class="avglabel" x="${svgW-padR}" y="${(avgY-4).toFixed(1)}" text-anchor="end">平均 ${avg.toFixed(1)}${key==='minutes'?'分':'%'}</text>`;

    const g = document.getElementById('chartGroup');
    g.innerHTML = gridSvg + avgSvg +
      `<path class="trendarea" d="${areaD}"></path>` +
      `<path class="trendline" d="${pathD}"></path>` +
      dotsSvg + labelSvg;
  }

  renderChart();
})();

</script>
</body>
</html>
