// 新規追加フラグ・設定
let skipStudyOnPause = false;   // pause() で勉強時間を加算しないフラグ（リセット時に使用）

const soundSettings = {
    workStart: {mode:"beep", url:"", duration:4},
    workEnd: {mode:"beep", url:"", duration:4},
    shortStart:{mode:"beep", url:"", duration:6},
    shortEnd: {mode:"beep", url:"", duration:4},
    longStart: {mode:"beep", url:"", duration:8},
    longEnd: {mode:"beep", url:"", duration:4}
};

// DOM要素キャッシュ
const els = {
    timer: document.getElementById("timer"),
    indicator: document.getElementById("indicator"),
    remain: document.getElementById("remain"),
    status: document.getElementById("status"),
    today: document.getElementById("today"),
