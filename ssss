function checkSchedule() {
    if (!els.scheduleEnabled.checked || !els.scheduleTime.value) return;
    const now = new Date();
    const nowStr = now.toTimeString().slice(0, 5);
    const todayISO = todayKey();
    const lastTrigger = localStorage.getItem("pomodoro_schedule_last");

    if (nowStr >= els.scheduleTime.value && lastTrigger !== todayISO) {
        localStorage.setItem("pomodoro_schedule_last", todayISO);
        if (!isRunning) {
            isWork = true;
            timeLeft = getWork();
            start();
            notify("予約時刻になったので勉強を開始します", "workStart");
        }
        els.scheduleStatus.textContent = `本日 ${els.scheduleTime.value} に自動開始しました。`;
    } else if (els.scheduleEnabled.checked) {
        els.scheduleStatus.textContent = `本日 ${els.scheduleTime.value} になったら自動でタイマーを開始します（このタブを開いたままにしてください）。`;
    }
