// ==================== ドラッグ関数（判定範囲広げ対応） ====================
function setupFloatWindowDrag(win) {
    let isDragging = false;
    let startX = 0, startY = 0;
    let startWinX = 0, startWinY = 0;

    const opener = window;
    const dragHandle = win.document.getElementById("floatContainer"); // 全体をドラッグ領域に

    function startDrag(e) {
        try { win.focus(); } catch(e){}
        isDragging = true;
        startX = e.screenX || e.clientX;
        startY = e.screenY || e.clientY;
        startWinX = win.screenX ?? win.screenLeft ?? 0;
        startWinY = win.screenY ?? win.screenTop ?? 0;
        e.preventDefault();
    }

    function onMouseMove(e) {
        if (!isDragging) return;
        const deltaX = (e.screenX || e.clientX) - startX;
        const deltaY = (e.screenY || e.clientY) - startY;
        const newX = Math.round(startWinX + deltaX);
        const newY = Math.round(startWinY + deltaY);
        try { win.moveTo(newX, newY); } catch (err) {}
    }

    function stopDrag() {
        isDragging = false;
    }

    // コンテナ全体にドラッグイベント
    dragHandle.addEventListener("mousedown", startDrag);
    
    opener.addEventListener("mousemove", onMouseMove);
    opener.addEventListener("mouseup", stopDrag);
    opener.addEventListener("mouseleave", stopDrag);

    win.addEventListener("mousemove", onMouseMove, true);
    win.addEventListener("mouseup", stopDrag, true);

    // フォーカス管理
    function setupFocusInterval() {
        clearFocusIntervalOnWin(win);
        const focusIntervalMs = powerSave ? 2500 : 500;
        try {
            win._focusInterval = setInterval(() => {
                if (win.closed) { clearFocusIntervalOnWin(win); return; }
                try { win.focus(); } catch(e){}
            }, focusIntervalMs);
        } catch(e){}
    }
    setupFocusInterval();

    win.addEventListener("beforeunload", () => {
        clearFocusIntervalOnWin(win);
        clearFloatSelfTick(win);
        opener.removeEventListener("mousemove", onMouseMove);
        opener.removeEventListener("mouseup", stopDrag);
        opener.removeEventListener("mouseleave", stopDrag);
    });
}
function clearFocusIntervalOnWin(win) {
    try {
        if (win && win._focusInterval) { clearInterval(win._focusInterval); win._focusInterval = null; }
    } catch(e){}
}

// called when powerSave toggled to update float focus interval
function updateFloatFocusInterval() {
    if (!floatWin || floatWin.closed) return;
    try {
        clearFocusIntervalOnWin(floatWin);
        const focusIntervalMs = powerSave ? 2500 : 500;
        floatWin._focusInterval = setInterval(() => {
            if (floatWin.closed) { clearFocusIntervalOnWin(floatWin); return; }
            try { floatWin.focus(); } catch(e){}
        }, focusIntervalMs);
    } catch(e){}
}

// 浮動ウィンドウ自身が endTimestamp を基準に独自描画する（親タブがバックグラウンドで
// スロットリングされても、フォーカスが当たっているフロートウィンドウ側は正確に動き続ける）
function startFloatSelfTick(win) {
    clearFloatSelfTick(win);
    win._selfTick = setInterval(() => {
        if (win.closed) { clearFloatSelfTick(win); return; }
        renderFloatFromState(win);
    }, 500);
}
function clearFloatSelfTick(win) {
    try {
        if (win && win._selfTick) { clearInterval(win._selfTick); win._selfTick = null; }
    } catch(e){}
}
function renderFloatFromState(win) {
    try {
        const timeEl = win.document.getElementById("floatTime");
        const modeEl = win.document.getElementById("floatMode");
        if (!timeEl || !modeEl) return;

        if (isRunning && endTimestamp) {
            const remain = Math.max(0, Math.ceil((endTimestamp - Date.now()) / 1000));
            const m = Math.floor(remain / 60);
            const s = remain % 60;
            timeEl.textContent = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        } else {
            timeEl.textContent = els.timer.textContent || "25:00";
        }
        modeEl.textContent = els.status.textContent || "待機中";
        modeEl.style.color = els.timer.classList.contains("work") ? "#bff7d0" :
                            els.timer.classList.contains("break") ? "#cfe7ff" : "#e6eef8";
    } catch (e) {}
}

